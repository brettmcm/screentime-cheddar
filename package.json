{
  "name": "screentime-cheddar",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "packages/cheddar-ds"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:ds": "npm run dev --workspace @screentime/cheddar-ds",
    "build": "npm run build --workspace @screentime/cheddar-ds && npm run build --workspace apps/web",
    "verify": "npm run verify --workspace @screentime/cheddar-ds && npm run verify --workspace apps/web",
    "test": "npm run test --workspaces --if-present",
    "test:visual": "npm run test:visual --workspace apps/web",
    "test:visual:update": "npm run test:visual:update --workspace apps/web",
    "tokens:build": "npm run tokens:build --workspace @screentime/cheddar-ds",
    "tokens:check": "npm run tokens:check --workspace @screentime/cheddar-ds",
    "figma:check-urls": "npm run figma:check-urls --workspace @screentime/cheddar-ds",
    "figma:url-sync": "npm run figma:url-sync --workspace @screentime/cheddar-ds",
    "figma:publish": "npm run figma:publish --workspace @screentime/cheddar-ds",
    "figma:publish:dry-run": "npm run figma:publish:dry-run --workspace @screentime/cheddar-ds",
    "figma:unpublish": "npm run figma:unpublish --workspace @screentime/cheddar-ds"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@figma/code-connect": "^1.4.8",
    "@fontsource-variable/mona-sans": "^5.2.8",
    "@fontsource/oswald": "^5.2.8",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.12.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.10",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "zod": "^4.4.3",
      "zod-validation-error": "^4.0.2"
    }
  }
}
