                  "components": [
                    0.13333,
                    0.05098,
                    0.0902
                  ],
                  "hex": "#220d17"
                },
                "$extensions": {
                  "com.cheddar.css": "color-mix(in srgb, var(--cds-color-brand-100) 20%, var(--token-color-neutral-900) 80%)",
                  "com.cheddar.mix": {
                    "space": "srgb",
                    "stops": [
                      {
                        "ref": "{color.semantic.brand.100}",
                        "weight": 20
                      },
                      {
