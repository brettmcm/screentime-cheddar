# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — do not commit secrets.

# Figma personal access token, used by Code Connect to publish component
# mappings to the Cheddar design system file.
# Generate one at: https://www.figma.com/settings → Personal access tokens
# Required scopes: File content (read), Code Connect (write).
FIGMA_ACCESS_TOKEN=
