      "background": {
        "$type": "color",
        "$description": "Page chrome. Tinted from the active brand ramp rather than a fixed magenta, so [data-brand] re-themes the whole surface stack.",
        "default": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.96471,
              0.94118,
              0.94902
            ],
            "hex": "#f6f0f2"
          },
          "$extensions": {
            "com.cheddar.css": "color-mix(in srgb, var(--cds-color-brand-100) 6%, var(--token-color-white-100) 94%)",
            "com.cheddar.mix": {
              "space": "srgb",
              "stops": [
