{
  "name": "@screentime/cheddar-ds",
  "version": "1.2.3",
  "private": true,
  "description": "Cheddar Design System — private React components, styles, and design tokens.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./demo-assets": {
      "types": "./src/demo-assets/index.ts",
      "import": "./src/demo-assets/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/tokens.ts",
      "import": "./src/tokens/tokens.ts"
    },
    "./styles.css": "./src/styles/index.css",
    "./styles/fonts.css": "./src/styles/fonts.css",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/foundation.css": "./src/styles/foundation.css",
    "./styles/components.css": "./src/styles/component-layers.css",
    "./tokens.json": "./tokens/cheddar.tokens.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens:build && vite build && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json --force",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "assets:check": "node scripts/check-demo-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run --project a11y",
    "verify": "npm run tokens:check && npm run assets:check && npm run lint && npm run typecheck && npm run test",
    "figma": "dotenv -e .env.local -- figma",
    "figma:url-sync": "node scripts/sync-figma-urls.mjs",
    "figma:check-urls": "node scripts/sync-figma-urls.mjs --check",
    "prefigma:publish": "npm run figma:url-sync",
    "figma:publish": "dotenv -e .env.local -- figma connect publish",
    "figma:publish:dry-run": "dotenv -e .env.local -- figma connect publish --dry-run",
    "figma:unpublish": "dotenv -e .env.local -- figma connect unpublish"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
